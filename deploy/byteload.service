[Unit]
Description=Byteload Metrics Agent
Documentation=https://github.com/yourusername/metrics-agent-go
After=network.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=byteload
Group=byteload
EnvironmentFile=/etc/byteload/env
ExecStart=/usr/local/bin/byteload-agent
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target 